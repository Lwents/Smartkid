<?xml version="1.0" encoding="utf-8"?>
<!--
  Một ô chỉ số: biểu tượng trong ô bo góc màu pastel + nhãn nhỏ ở trên và
  con số lớn ở dưới. Dùng lại cho cả 5 ô nên chúng luôn cùng cỡ chữ.
  Con số gồm 2 phần: phần đạt được in đậm và phần "/ tổng" mờ hơn.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/frameStatIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/ai_bg_circle_purple">

        <ImageView
            android:id="@+id/iconStat"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="center"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Cho phép xuống 2 dòng: "Điểm trung bình" / "Mục tiêu hôm nay" không đủ
             chỗ trên một dòng ở màn hình hẹp và sẽ bị cắt thành "Điểm ...". -->
        <TextView
            android:id="@+id/textStatLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="-1dp"
            android:maxLines="2"
            android:textColor="@color/smartkid_text_secondary"
            android:textSize="11.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textStatValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/smartkid_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textStatTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="1dp"
                android:textColor="@color/smartkid_text_tertiary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
