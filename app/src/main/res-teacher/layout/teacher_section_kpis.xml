        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Smartkid.AdminGlassCard"
            android:layout_width="0dp"
            android:layout_height="136dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="9dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/admin_bg_icon_cyan"
                        android:contentDescription="@null"
                        android:padding="7dp"
                        android:src="@drawable/admin_ic_chart"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/textTeacherCompletionRate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/teacher_completion_zero"
                        android:textColor="@color/admin_text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />
