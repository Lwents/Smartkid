<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/teacherDashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/admin_bg_screen">

    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-90dp"
        android:layout_marginEnd="-80dp"
        android:background="@drawable/admin_bg_glow_blue" />

    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="-120dp"
        android:background="@drawable/admin_bg_glow_green" />

    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-100dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/admin_bg_glow_purple" />

    <ViewFlipper
        android:id="@+id/teacherPageFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refreshTeacherOverview"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/teacherDashboardScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="104dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/buttonTeacherRefresh"
                    style="@style/Widget.Smartkid.AdminGlassCard.Interactive"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/refresh"
                    app:cardCornerRadius="20dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/admin_ic_menu"
                        app:tint="@color/admin_text_primary" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/teacher_dashboard_title"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textTeacherWelcome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/admin_text_secondary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/buttonTeacherNotifications"
                        style="@style/Widget.Smartkid.AdminGlassCard.Interactive"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/notifications"
                        app:cardCornerRadius="20dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:padding="10dp"
                            android:src="@drawable/admin_ic_bell"
                            app:tint="@color/admin_text_primary" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/textTeacherNotificationBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/admin_badge_dot_primary"
                        android:gravity="center"
                        android:minWidth="18dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/buttonTeacherLogout"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:contentDescription="@string/logout"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/textTeacherAvatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/admin_bg_avatar"
                        android:gravity="center"
                        android:text="@string/teacher_avatar_fallback"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/admin_badge_dot_online" />
                </FrameLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressTeacherDashboard"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/admin_primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textTeacherDashboardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/admin_bg_error_message"
                android:padding="12dp"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <include layout="@layout/teacher_section_kpis" />
            <include layout="@layout/teacher_section_quick_actions" />

            <TextView
                style="@style/TextAppearance.Smartkid.AdminSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:text="@string/teacher_activity_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:text="@string/teacher_chart_scope"
                android:textColor="@color/admin_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Smartkid.AdminGlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/teacher_chart_metric"
                            android:textColor="@color/admin_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textTeacherChartTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/teacher_chart_total_zero"
                            android:textColor="@color/admin_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="188dp"
                        android:layout_marginTop="8dp">

                        <com.example.smartkid.common.ui.chart.ActivityChartView
                            android:id="@+id/teacherActivityChart"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/textTeacherChartEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:padding="24dp"
                            android:text="@string/teacher_chart_empty"
                            android:textAlignment="center"
                            android:textColor="@color/admin_text_muted"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Smartkid.AdminSectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/my_courses" />

                <TextView
                    android:id="@+id/buttonTeacherViewAllCourses"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:drawablePadding="4dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/view_all"
                    android:textColor="@color/admin_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:drawableEndCompat="@drawable/role_ic_chevron_right"
                    app:drawableTint="@color/admin_primary" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTeacherCoursesEmpty"
                style="@style/Widget.Smartkid.AdminGlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp">

                <TextView
                    android:id="@+id/textTeacherNoCourses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:minHeight="104dp"
                    android:padding="16dp"
                    android:text="@string/no_teacher_courses"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="13sp"
                    app:drawableTopCompat="@drawable/profile_ic_book"
                    app:drawableTint="@color/admin_primary" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/containerTeacherCourses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <include layout="@layout/teacher_page_courses" />
        <include layout="@layout/teacher_page_exams" />
        <include layout="@layout/teacher_page_students" />
    </ViewFlipper>

    <FrameLayout
        android:id="@+id/teacherBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/floating_nav_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/floating_nav_margin_horizontal"
        android:layout_marginEnd="@dimen/floating_nav_margin_horizontal"
        android:layout_marginBottom="@dimen/floating_nav_margin_bottom"
        android:background="@drawable/admin_bg_bottom_navigation"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="12dp"
        android:padding="4dp">

        <View
            android:id="@+id/teacherNavSelectionIndicator"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@drawable/admin_bg_nav_item_selected"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/buttonTeacherNavOverview"
                style="@style/Widget.Smartkid.FloatingNavigation.Item.Pager"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/admin_nav_overview"
                android:textColor="@color/admin_nav_item_color"
                app:drawableTint="@color/admin_nav_item_color"
                app:drawableTopCompat="@drawable/admin_ic_home" />

            <TextView
                android:id="@+id/buttonTeacherNavCourses"
                style="@style/Widget.Smartkid.FloatingNavigation.Item.Pager"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/nav_courses"
                android:textColor="@color/admin_nav_item_color"
                app:drawableTint="@color/admin_nav_item_color"
                app:drawableTopCompat="@drawable/admin_ic_course" />

            <TextView
                android:id="@+id/buttonTeacherNavExams"
                style="@style/Widget.Smartkid.FloatingNavigation.Item.Pager"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/nav_exams"
                android:textColor="@color/admin_nav_item_color"
                app:drawableTint="@color/admin_nav_item_color"
                app:drawableTopCompat="@drawable/common_ic_nav_exam" />

            <TextView
                android:id="@+id/buttonTeacherNavStudents"
                style="@style/Widget.Smartkid.FloatingNavigation.Item.Pager"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/teacher_students_stat"
                android:textColor="@color/admin_nav_item_color"
                app:drawableTint="@color/admin_nav_item_color"
                app:drawableTopCompat="@drawable/admin_ic_users" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
