<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootTeacherQuestionSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/teacher_bg_question_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="72dp">

        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/notification_bg_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textTeacherQuestionSheetAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/teacher_bg_question_avatar"
                android:gravity="center"
                android:textColor="@color/smartkid_primary_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textTeacherQuestionSheetStudent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/smartkid_text"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textTeacherQuestionSheetTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/smartkid_text_tertiary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/buttonTeacherQuestionClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Đóng"
                android:padding="12dp"
                android:src="@drawable/course_ic_close"
                app:tint="@color/smartkid_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/textTeacherQuestionSheetStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/teacher_bg_question_pending"
            android:paddingStart="11dp"
            android:paddingTop="6dp"
            android:paddingEnd="11dp"
            android:paddingBottom="6dp"
            android:textColor="@color/teacher_question_pending_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:text="Học sinh hỏi:"
            android:textColor="@color/smartkid_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textTeacherQuestionSheetContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/teacher_bg_question_bubble"
            android:lineSpacingExtra="4dp"
            android:padding="17dp"
            android:textColor="@color/smartkid_text"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:text="Bài học liên quan"
            android:textColor="@color/smartkid_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/teacher_bg_question_empty"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/teacher_bg_question_avatar">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/common_ic_nav_course"
                    app:tint="@color/smartkid_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/textTeacherQuestionSheetContext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/smartkid_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Smartkid.GlassInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:hint="Viết câu trả lời cho học sinh">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputTeacherQuestionReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="2000"
                android:maxLines="5"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonTeacherQuestionSendReply"
            style="@style/Widget.Smartkid.GlassButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Gửi câu trả lời"
            app:icon="@drawable/notification_ic_reply"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonTeacherQuestionOpenLesson"
            style="@style/Widget.Smartkid.GlassButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="9dp"
            android:text="Xem bài học"
            app:icon="@drawable/common_ic_nav_course"
            app:iconGravity="textStart" />

        <TextView
            android:id="@+id/textTeacherQuestionRepliesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Lịch sử trao đổi"
            android:textColor="@color/smartkid_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutTeacherQuestionReplies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/textTeacherQuestionNoReplies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/teacher_bg_question_empty"
            android:gravity="center"
            android:padding="18dp"
            android:text="Chưa có phản hồi. Hãy giúp học sinh giải đáp câu hỏi này."
            android:textColor="@color/smartkid_text_secondary"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
