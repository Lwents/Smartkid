<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        style="@style/TextAppearance.Smartkid.AdminSectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:text="@string/role_quick_actions" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="11dp"
        android:columnCount="2">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/buttonTeacherCreateCourse"
            style="@style/Widget.Smartkid.AdminGlassCard.Interactive"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/admin_bg_quick_blue">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/admin_ic_course"
                        app:tint="@color/admin_blue" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:text="@string/create_course"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/role_ic_chevron_right"
                    app:tint="@color/admin_text_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/buttonTeacherCreateExam"
            style="@style/Widget.Smartkid.AdminGlassCard.Interactive"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/admin_bg_quick_green">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/role_ic_exam"
                        app:tint="@color/admin_green" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:text="@string/create_exam"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/role_ic_chevron_right"
                    app:tint="@color/admin_text_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/buttonTeacherReports"
            style="@style/Widget.Smartkid.AdminGlassCard.Interactive"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/admin_bg_quick_purple">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/admin_ic_approval"
                        app:tint="@color/admin_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:text="@string/teacher_grade_action"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/role_ic_chevron_right"
                    app:tint="@color/admin_text_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/buttonTeacherStudents"
            style="@style/Widget.Smartkid.AdminGlassCard.Interactive"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/admin_bg_quick_cyan">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/admin_ic_users"
                        app:tint="@color/admin_cyan" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:text="@string/teacher_manage_students_action"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/role_ic_chevron_right"
                    app:tint="@color/admin_text_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </GridLayout>
</merge>
