<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="13dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="8dp"
        android:text="@string/management_course_grade"
        android:textColor="@color/admin_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/groupManagementCourseGrade"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="5">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipManagementGrade1"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:checkable="true"
            android:checked="true"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/management_grade_one"
            android:textAllCaps="false"
            android:textColor="@color/management_grade_chip_text"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@color/management_grade_chip_background"
            app:cornerRadius="14dp"
            app:strokeColor="@color/admin_glass_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipManagementGrade2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:checkable="true"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/management_grade_two"
            android:textAllCaps="false"
            android:textColor="@color/management_grade_chip_text"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@color/management_grade_chip_background"
            app:cornerRadius="14dp"
            app:strokeColor="@color/admin_glass_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipManagementGrade3"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:checkable="true"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/management_grade_three"
            android:textAllCaps="false"
            android:textColor="@color/management_grade_chip_text"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@color/management_grade_chip_background"
            app:cornerRadius="14dp"
            app:strokeColor="@color/admin_glass_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipManagementGrade4"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:checkable="true"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/management_grade_four"
            android:textAllCaps="false"
            android:textColor="@color/management_grade_chip_text"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@color/management_grade_chip_background"
            app:cornerRadius="14dp"
            app:strokeColor="@color/admin_glass_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipManagementGrade5"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:checkable="true"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/management_grade_five"
            android:textAllCaps="false"
            android:textColor="@color/management_grade_chip_text"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@color/management_grade_chip_background"
            app:cornerRadius="14dp"
            app:strokeColor="@color/admin_glass_stroke"
            app:strokeWidth="1dp" />
    </LinearLayout>
</LinearLayout>
