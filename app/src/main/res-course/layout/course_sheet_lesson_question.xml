<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/discussion_bg_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="72dp">

        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/notification_bg_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/discussion_bg_avatar_student">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/role_ic_question"
                    app:tint="@color/smartkid_primary_dark" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cuộc trò chuyện bài học"
                    android:textColor="@color/smartkid_text"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textDiscussionQuestionTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/smartkid_text_tertiary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/buttonDiscussionCloseTop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Đóng"
                android:padding="12dp"
                android:src="@drawable/course_ic_close"
                app:tint="@color/smartkid_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/textDiscussionQuestionAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/smartkid_primary_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDiscussionQuestionContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/discussion_bg_question_bubble"
            android:lineSpacingExtra="4dp"
            android:padding="17dp"
            android:textColor="@color/smartkid_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/textDiscussionRepliesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:textColor="@color/smartkid_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutDiscussionReplies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/textDiscussionNoReplies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/discussion_bg_empty_reply"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:padding="18dp"
            android:text="Thầy cô chưa trả lời. Em chờ một chút nhé!"
            android:textColor="@color/smartkid_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDiscussionReply"
            style="@style/Widget.Smartkid.GlassButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="Viết phản hồi"
            app:icon="@drawable/notification_ic_reply"
            app:iconGravity="textStart" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDiscussionLike"
                style="@style/Widget.Smartkid.GlassButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Thích" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDiscussionEdit"
                style="@style/Widget.Smartkid.GlassButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:text="Sửa câu hỏi" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDiscussionReport"
                style="@style/Widget.Smartkid.GlassButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:text="Báo cáo" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDiscussionDelete"
            style="@style/Widget.Smartkid.GlassButton.Text"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="Xóa câu hỏi"
            android:textColor="@color/smartkid_error" />

    </LinearLayout>
</ScrollView>
