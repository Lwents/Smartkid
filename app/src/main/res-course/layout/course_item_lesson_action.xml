<?xml version="1.0" encoding="utf-8"?>
<!--
  Một thẻ thao tác ở màn học bài: icon trong vòng tròn + tiêu đề + dòng mô tả.
  Dùng lại cho 4 thẻ (hỏi đáp, Gia Sư AI, bài trước, bài tiếp) nên các thẻ luôn
  cùng kích thước và cùng kiểu chữ.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/course_bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/course_bg_icon_circle">

        <ImageView
            android:id="@+id/iconLessonAction"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            app:tint="@color/role_primary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textLessonActionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/role_primary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textLessonActionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:textColor="@color/smartkid_text_secondary"
            android:textSize="12.5sp" />
    </LinearLayout>
</LinearLayout>
