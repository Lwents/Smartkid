<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLessonDiscussion"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/smartkid_background"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarLessonDiscussion"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/glass_toolbar"
        app:navigationIcon="@drawable/common_ic_arrow_back"
        app:navigationIconTint="@color/smartkid_text"
        app:subtitleTextColor="@color/smartkid_text_secondary"
        app:title="@string/lesson_discussion"
        app:titleTextColor="@color/smartkid_text" />
    <ProgressBar
        android:id="@+id/progressLessonDiscussion"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />
    <TextView
        android:background="@null"
        android:id="@+id/textLessonDiscussionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp"
        android:textColor="@color/smartkid_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refreshLessonDiscussion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ListView
            android:id="@+id/listLessonQuestions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="12dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp" />
        <TextView
            android:background="@null"
            android:id="@+id/textLessonDiscussionEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/no_discussion_questions"
            android:textColor="@color/smartkid_text_secondary" />
    </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/glass_surface_strong"
        app:cardCornerRadius="24dp"
        app:cardElevation="5dp"
        app:strokeColor="@color/glass_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp"
                android:text="@string/discussion_prompt"
                android:textColor="@color/smartkid_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Smartkid.GlassInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/discussion_question_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputLessonQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="2000"
                    android:maxLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSendLessonQuestion"
                style="@style/Widget.Smartkid.GlassButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="9dp"
                android:text="@string/send_question"
                app:icon="@drawable/notification_ic_reply"
                app:iconGravity="textStart" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
