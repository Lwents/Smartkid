<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarLessonPlayer"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/glass_toolbar"
        app:navigationIcon="@drawable/common_ic_arrow_back"
        app:navigationIconTint="@color/smartkid_text"
        app:title="@string/lesson_content"
        app:titleTextColor="@color/smartkid_text" />

    <ProgressBar
        android:id="@+id/progressLessonLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding_compact">

            <VideoView
                android:id="@+id/videoLesson"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:background="@color/black"
                android:contentDescription="@string/lesson_content"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/containerLessonWebVideo"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:background="@color/black"
                android:visibility="gone">

                <WebView
                    android:id="@+id/webLessonVideo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/black"
                    android:visibility="gone" />
            </FrameLayout>

            <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                android:id="@+id/youtubeLessonPlayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/black"
                android:visibility="gone"
                app:autoPlay="false"
                app:enableAutomaticInitialization="false" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textLessonContentType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/course_bg_hero_badge"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="@string/lesson_content"
                    android:textColor="@color/smartkid_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textLessonContentStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/lesson_not_completed"
                    android:textColor="@color/smartkid_success"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/common_bg_glass_card"
                android:clipToOutline="true"
                android:elevation="@dimen/glass_elevation">

                <TextView
                    android:id="@+id/textLessonContent"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="130dp"
                    android:padding="18dp"
                    android:text="@string/no_text_content"
                    android:textColor="@color/smartkid_text"
                    android:textIsSelectable="true"
                    android:textSize="16sp"
                    android:lineSpacingExtra="5dp" />
            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLessonExercises"
                style="@style/Widget.Smartkid.AdminGlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lesson_exercises_title"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/lesson_exercises_subtitle"
                        android:textColor="@color/admin_text_secondary"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/containerLessonExercises"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonLessonDiscussion"
                    style="@style/Widget.Smartkid.GlassButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/lesson_discussion"
                    app:icon="@drawable/role_ic_question"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonLessonAiTutor"
                    style="@style/Widget.Smartkid.GlassButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/ai_tutor"
                    app:icon="@drawable/ai_ic_tutor"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonOpenExternal"
                style="@style/Widget.Smartkid.GlassButton.Outlined"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/open_content"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCompleteLesson"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:enabled="false"
                android:text="@string/mark_completed"
                app:cornerRadius="@dimen/glass_radius_large" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
