<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Smartkid.GlassInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="@string/management_matching_left"
        app:boxBackgroundColor="@color/admin_glass_soft">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputMatchingLeft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:textColor="@color/admin_text_primary"
            android:textSize="12sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="28dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="@string/management_matching_arrow"
        android:textColor="@color/admin_text_secondary"
        android:textSize="17sp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Smartkid.GlassInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="@string/management_matching_right"
        app:boxBackgroundColor="@color/admin_glass_soft">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputMatchingRight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:textColor="@color/admin_text_primary"
            android:textSize="12sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/buttonMatchingPairDelete"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/management_remove_symbol"
        android:textColor="@color/admin_red"
        android:textSize="22sp" />
</LinearLayout>
