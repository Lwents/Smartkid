<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="7dp"
        android:text="@string/management_video_source_label"
        android:textColor="@color/admin_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleManagementVideoSource"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        app:checkedButton="@id/buttonManagementVideoYoutube"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonManagementVideoYoutube"
            style="@style/Widget.Smartkid.GlassButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:checked="true"
            android:text="@string/management_video_source_youtube"
            android:textAllCaps="false"
            android:textColor="@color/admin_primary"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonManagementVideoFile"
            style="@style/Widget.Smartkid.GlassButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/management_video_source_file"
            android:textAllCaps="false"
            android:textColor="@color/admin_text_secondary"
            app:cornerRadius="18dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
