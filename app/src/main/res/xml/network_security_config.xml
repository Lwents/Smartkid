<?xml version="1.0" encoding="utf-8"?>
<!--
  Chỉ cho phép HTTP không mã hóa với các host backend đã biết.
  Mọi host khác bắt buộc HTTPS. Khi VPS chuyển sang HTTPS (khuyến nghị),
  hãy xóa mục 160.250.181.242 khỏi danh sách này.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- VPS dự phòng (nginx cổng 80) -->
        <domain includeSubdomains="false">160.250.181.242</domain>
        <!-- Backend local khi chạy emulator -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Máy dev trong LAN (local.properties API_BASE_URL) -->
        <domain includeSubdomains="false">192.168.1.4</domain>
    </domain-config>
</network-security-config>
