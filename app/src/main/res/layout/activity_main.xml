<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSplash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/smartkid_background"
    android:fitsSystemWindows="true"
    android:padding="24dp">

    <!-- Center Content Container (Logo, Title, Slogan, Loading) -->
    <LinearLayout
        android:id="@+id/layoutSplashContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/layoutErrorContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <!-- Logo -->
        <TextView
            android:id="@+id/textSplashLogo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/common_bg_logo"
            android:elevation="@dimen/glass_elevation_high"
            android:gravity="center"
            android:text="@string/logo_initials"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- App Name Title -->
        <TextView
            android:id="@+id/textSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_name"
            android:textColor="@color/smartkid_text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- App Slogan Description -->
        <TextView
            android:id="@+id/textSplashSlogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/app_slogan"
            android:textColor="@color/smartkid_text_secondary"
            android:textSize="16sp" />

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/progressSplash"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/loading"
            android:indeterminateTint="@color/smartkid_primary" />

    </LinearLayout>

    <!-- Error Fallback Container -->
    <LinearLayout
        android:id="@+id/layoutErrorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/textSplashError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/splash_load_failed"
            android:textColor="@color/smartkid_error"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSplashRetry"
            style="@style/Widget.Smartkid.GlassButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/retry" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
